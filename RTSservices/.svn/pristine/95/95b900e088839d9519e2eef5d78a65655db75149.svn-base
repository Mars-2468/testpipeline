			    "    (wtt.assignee_place_holder = 'SendDemand' AND ra.workflow_status IN (0, 3, 5)) " +
			    "    OR " +
			    "    (wtt.assignee_place_holder = 'CloseApplication' AND ra.workflow_status IN (1, 2, 5)) " +
			    "  ) " +
			    "GROUP BY ra.rti_application_id " +
			    "ORDER BY ra.rti_application_id DESC";


	}else {
		sqlQuery = "SELECT COUNT(DISTINCT ra.*) " +
	            "FROM egovrti.rti_application ra " +
                "WHERE ra.rti_application_number IS NOT NULL AND ra.rti_application_number != '' AND ra.workflow_status IN (0, 3, 5,2,1)" +
