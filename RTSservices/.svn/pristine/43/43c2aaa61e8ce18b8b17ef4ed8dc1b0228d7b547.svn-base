package com.mars.rti.model;

import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.Id;
import javax.persistence.Table;

@Entity
@Table(name ="fire_floor_name", schema="egovrti")
public class FireFloorName 
{
	@Id
	@Column(name="fire_floor_name_id",nullable=false,unique=true)
	private long fireFloorNameId;
	
	@Column(name = "fire_floor_names")
	private String fireFloorNames;
	
	@Column(name = "fire_floor_types_id")
	private String fireFloorTypesId;

	public long getFireFloorNameId() {
		return fireFloorNameId;
	}

	public void setFireFloorNameId(long fireFloorNameId) {
		this.fireFloorNameId = fireFloorNameId;
	}

	public String getFireFloorNames() {
		return fireFloorNames;
	}

	public void setFireFloorNames(String fireFloorNames) {
		this.fireFloorNames = fireFloorNames;
	}

	public String getFireFloorTypesId() {
		return fireFloorTypesId;
	}

	public void setFireFloorTypesId(String fireFloorTypesId) {
		this.fireFloorTypesId = fireFloorTypesId;
	}
	
	
}
