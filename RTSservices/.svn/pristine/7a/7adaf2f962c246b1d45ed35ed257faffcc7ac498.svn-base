package com.mars.rti.ws.model;

import java.io.Serializable;

import org.springframework.http.HttpStatus;

import com.fasterxml.jackson.annotation.JsonPropertyOrder;

@JsonPropertyOrder({ "key", "filesPath", "requestType", "rtsApplicationNumber", "responseStatus",
		"result", "responseCode" })
public class TaxUploadRestDTO implements Serializable {

	/**
	* 
	*/
	private static final long serialVersionUID = 1L;

	private String key;

	private String filesBase64Data;

	private String requestType;

	private String rtsApplicationNumber;

	private String responseStatus;

	private String result;

	private int responseCode;

	

	public String getKey() {
		return key;
	}

	public void setKey(String key) {
		this.key = key;
	}

	

	public String getFilesBase64Data() {
		return filesBase64Data;
	}

	public void setFilesBase64Data(String filesBase64Data) {
		this.filesBase64Data = filesBase64Data;
	}

	public String getRequestType() {
		return requestType;
	}

	public void setRequestType(String requestType) {
		this.requestType = requestType;
	}

	public String getRtsApplicationNumber() {
		return rtsApplicationNumber;
	}

	public void setRtsApplicationNumber(String rtsApplicationNumber) {
		this.rtsApplicationNumber = rtsApplicationNumber;
	}

	public String getResponseStatus() {
		return responseStatus;
	}

	public void setResponseStatus(String responseStatus) {
		this.responseStatus = responseStatus;
	}

	public String getResult() {
		return result;
	}

	public void setResult(String result) {
		this.result = result;
	}

	public static long getSerialversionuid() {
		return serialVersionUID;
	}

	public int getResponseCode() {
		return responseCode;
	}

	public void setResponseCode(int responseCode) {
		this.responseCode = responseCode;
	}

}
