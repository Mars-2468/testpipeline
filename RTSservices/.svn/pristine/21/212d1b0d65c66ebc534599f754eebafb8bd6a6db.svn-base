<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="
http://maven.apache.org/POM/4.0.0
http://maven.apache.org/maven-v4_0_0.xsd">
<modelVersion>4.0.0</modelVersion>
<groupId>mars</groupId>
<artifactId>webservices</artifactId>
<packaging>war</packaging>
<name>Mars Admin</name>
<version>0.1</version>
<description />
<build>
<sourceDirectory>java</sourceDirectory>
<scriptSourceDirectory>scripts</scriptSourceDirectory>
<testSourceDirectory>admin/java</testSourceDirectory>
<outputDirectory>
target/admin/WEB-INF/classes
</outputDirectory>
<testOutputDirectory>target/test-classes</testOutputDirectory>
<resources>
<resource>
<filtering>true</filtering>
<directory>resources</directory>
<includes>
<include>log4j.xml</include>
<include>messages.properties</include>
<include>hibernate.properties</include>
</includes>
</resource>
<resource>
<filtering>true</filtering>
<directory>resources/hibernate/common</directory>
<includes>
<include>*.hbm.xml</include>
</includes>
</resource>
<resource>
<filtering>true</filtering>
<directory>resources/common</directory>
<includes>
<include>*.xml</include>
</includes>
</resource>
</resources>
<testResources>
<testResource>
<directory>admin/test/resources</directory>
</testResource>
</testResources>
<directory>target</directory>
<finalName>admin</finalName>
<plugins>
<plugin>
<artifactId>maven-compiler-plugin</artifactId>
<version>3.2</version>
<configuration>
<source>1.6</source>
<target>1.6</target>
</configuration>
</plugin>
<plugin>
<artifactId>maven-war-plugin</artifactId>
<configuration>
<webXml>resources/web.xml</webXml>
</configuration>
</plugin>

<plugin>
<groupId>org.apache.maven.plugins</groupId>
<artifactId>maven-jar-plugin</artifactId>
<configuration></configuration>
<executions>
<execution>
<goals>
<goal>jar</goal>
</goals>
</execution>
</executions>
</plugin>

<plugin>
<artifactId>maven-site-plugin</artifactId>
<configuration>
<locales>en,fr</locales>
</configuration>
</plugin>

<plugin>
<artifactId>maven-antrun-plugin</artifactId>
<executions>
<execution>
<phase>process-resources</phase>
<goals>
<goal>run</goal>
</goals>
<configuration>
<tasks>
<copy todir="target/admin/images">
<fileset dir="web/images"></fileset>
</copy>
<copy todir="target/admin/pages">
<fileset dir="web/pages" />
</copy>
<copy todir="target/admin/scripts">
<fileset dir="web/scripts" />
</copy>
<copy todir="target/admin/styles">
<fileset dir="web/styles" />
</copy>
<copy
todir="target/admin/META-INF">
<fileset dir="web/META-INF" />
</copy>
<copy todir="target/admin/WEB-INF">
<fileset dir="resources">
<exclude
name="messages.properties">
</exclude>
<exclude
name="hibernate.properties">
</exclude>
<exclude name="log4j.xml"></exclude>
<exclude name="*.vm"></exclude>
<include name="*.*"></include>
</fileset>
<fileset dir="resources/common">
<include name="*.xml"></include>
</fileset>
</copy>
<copy
todir="target/admin/WEB-INF/classes/hibernate/common">
<fileset
dir="resources/hibernate/common">
<include name="*.hbm.xml"></include>
</fileset>
</copy>
<copy
todir="target/admin/WEB-INF/tiles">
<fileset dir="web/WEB-INF/tiles" />
</copy>
<copy
todir="target/admin/WEB-INF/lib">
<fileset dir="web/WEB-INF/lib" />
</copy>
<copy
todir="target/admin/WEB-INF/tlds">
<fileset dir="web/WEB-INF/tlds" />
</copy>
<delete>
<fileset
dir="target/admin/WEB-INF/classes">
<include name="*.hbm.xml" />
<include name="Common-*.xml"></include>
</fileset>
</delete>
</tasks>
</configuration>
</execution>
</executions>
</plugin>

<plugin>
<artifactId>maven-help-plugin</artifactId>
<version>2.0.1</version>
</plugin>

</plugins>
</build>

<properties>
<spring.framework.version>
4.0.6.RELEASE
</spring.framework.version>
<hibernate.version>4.3.6.Final</hibernate.version>
<org.slf4j.version>1.5.2</org.slf4j.version>
</properties>

<dependencies>
<dependency>
    <groupId>javax.servlet.jsp.jstl</groupId>
    <artifactId>jstl-api</artifactId>
    <version>1.2</version>
</dependency>


<!-- Spring -->
<dependency>
<groupId>org.springframework</groupId>
<artifactId>spring-beans</artifactId>
<version>${spring.framework.version}</version>
</dependency>

