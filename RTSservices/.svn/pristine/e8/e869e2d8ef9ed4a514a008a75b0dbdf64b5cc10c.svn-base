package com.mars.rti.dao.impl;

import java.util.List;

import org.apache.commons.logging.Log;
import org.apache.commons.logging.LogFactory;
import org.hibernate.HibernateException;
import org.hibernate.Query;
import org.hibernate.SessionFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.orm.hibernate3.support.HibernateDaoSupport;
import org.springframework.stereotype.Repository;

import com.mars.rti.dao.DogLicenceCertificateDAO;
import com.mars.rti.model.DogDetails;
import com.mars.rti.model.DogLicenseCertificate;

@Repository("dogLicenceCertificateDAO")
public class DogLicenceCertificateDAOImpl extends HibernateDaoSupport  implements DogLicenceCertificateDAO {

	private static final Log log =LogFactory.getLog(DogLicenceCertificateDAOImpl.class);

	@Autowired
	public void init(SessionFactory factory) {
		setSessionFactory(factory);
	}
	
	@Override
	public long saveDogCertificateLicence(DogLicenseCertificate dogLicenseCertificate) {
		DogLicenseCertificate d=null;
		try
		{
		    if (log.isDebugEnabled())
		    {
			log.debug("save Method is called ");
		    }
		    d=(DogLicenseCertificate)getHibernateTemplate().merge(dogLicenseCertificate);
		    
		    if(d!=null){
		    	return d.getDogId();
		    }
		} catch (NullPointerException nullpointerexception)
		{
		    log.error(nullpointerexception.getStackTrace());
		    throw new NullPointerException();
		} catch (HibernateException hibernateException)
		{
		    hibernateException.printStackTrace();
		    log.error(hibernateException.getStackTrace());
		    throw new HibernateException(hibernateException.getMessage());
		} catch (Exception exception)
		{
		    exception.printStackTrace();
		    log.error(exception.getStackTrace());
		    throw new RuntimeException(exception.getCause());
		}
		return d.getDogId();
	}
	
	
	public DogLicenseCertificate get(long id) {
		try {
			if (log.isDebugEnabled()) {
				log.debug("get Method is called " + id);
			}
			return (DogLicenseCertificate) getHibernateTemplate().get(DogLicenseCertificate.class, new Long(id));
		} catch (Exception exception) {
			log.error(exception.getStackTrace(), exception);
			exception.printStackTrace();
		}
		return null;
	}
	
	public DogDetails merge(DogDetails entity) {
//    	try {
//      		if (log.isDebugEnabled()) 
//      		{
//        		log.debug("merge Method is called ");
//      		}
//		    return (DogDetails) getHibernateTemplate().merge(entity);
//		} catch (Exception exception)
//		{
//	    	log.error(exception.getStackTrace());
//	    	exception.printStackTrace();
//		}
//		return null;
//  }
	
		try {
      		if (log.isDebugEnabled()) 
      		{
        		log.debug("merge Method is called ");
      		}
      		
      		if (entity.getDogDetailsId() > 0) {
      			DogDetails addressDetails =(DogDetails) getHibernateTemplate().get(DogDetails.class,new Long(entity.getDogDetailsId()));
    			getHibernateTemplate().evict(addressDetails);
    			getHibernateTemplate().flush();
			}
		    return (DogDetails) getHibernateTemplate().merge(entity);
		} catch (Exception exception)
		{
	    	log.error(exception.getStackTrace(),exception);
	    	exception.printStackTrace();
		}
		return null;
  }
	@Override
	public DogLicenseCertificate getDetails(long rtiApplicationId) {
		try{

			String sqlQuery="select dogLicenseCertificate from DogLicenseCertificate dogLicenseCertificate where rti_ref_id = "+rtiApplicationId;

			Query query = getSession().createQuery(sqlQuery);

			List list = query.list();

			if (list != null && list.size() > 0)     
				return (DogLicenseCertificate) list.get(0);
		}catch(Exception e){
			log.error(e.getStackTrace());
			e.printStackTrace();
		}
		return null;
	}


}
