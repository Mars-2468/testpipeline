	@Controller
	public class TradeLicenseTypeChangeRestController {

			private static Log log = LogFactory.getLog(TradeLicenseTypeChangeRestController.class);

			@Autowired
			private RTIApplicationService rtiApplicationService;

			@Autowired
			private TradeLicenseTypeChangeService tradeLicenseTypeChangeService;
			

			@RequestMapping(method = RequestMethod.POST, value = "/saveTradeTypeChangeApplication")
			public @ResponseBody TradeLicenseTypeChangeRestDTO saveTradeLicenseTypeChange(@RequestBody TradeLicenseTypeChangeRestDTO tradeLicenseTypeChangeRestDTO,
					HttpServletRequest request, HttpServletResponse reponse) throws ServletException {
				boolean condition = true;
				StringBuilder message = new StringBuilder();
				String[] files = new String[5];

				UserRegistrationDetails user = new UserRegistrationDetails();

				if (log.isDebugEnabled()) {
					log.debug("Invoking saveTradeLicenseTypeChange");
				}
				TradeLicenseTypeChange tradeLicenseTypeChange = new TradeLicenseTypeChange();


				try {
					if (tradeLicenseTypeChangeRestDTO.getTitle() != null
							&& !tradeLicenseTypeChangeRestDTO.getTitle().isEmpty()) {
						tradeLicenseTypeChange.setTitle(tradeLicenseTypeChangeRestDTO.getTitle());
					} else {
						String Title = "Title field is Required";
						condition = false;
						message.append(Title).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getName() != null
							&& !tradeLicenseTypeChangeRestDTO.getName().isEmpty()) {
						tradeLicenseTypeChange.setFirstName(tradeLicenseTypeChangeRestDTO.getName());			
						} else {
						String FirstName = "Name field is Required";
						condition = false;
						message.append(FirstName).append(",");
					}			

					tradeLicenseTypeChange.setMiddleName(tradeLicenseTypeChangeRestDTO.getFatherName());
					
					if (tradeLicenseTypeChangeRestDTO.getSurname() != null
							&& !tradeLicenseTypeChangeRestDTO.getSurname().isEmpty()) {
						tradeLicenseTypeChange.setLastName(tradeLicenseTypeChangeRestDTO.getSurname());			
						} else {
						String LastName ="Surname field is Required";
						condition = false;
						message.append(LastName).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getFullName() != null
							&& !tradeLicenseTypeChangeRestDTO.getFullName().isEmpty()) {
						tradeLicenseTypeChange.setFullName(tradeLicenseTypeChangeRestDTO.getFullName());
					} else {
						String FullName = "Full Name field is Required";
						condition = false;
						message.append(FullName).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getPinCode() != 0) {
						tradeLicenseTypeChange.setPinCode(tradeLicenseTypeChangeRestDTO.getPinCode());
						} else {
						String PinCode = "Pin Code field is Required";
						condition = false;
						message.append(PinCode).append(",");
					}
					tradeLicenseTypeChange.setAadhaarNo(tradeLicenseTypeChangeRestDTO.getAadhaarNo());
					if (tradeLicenseTypeChangeRestDTO.getEmailID() != null
							&& !tradeLicenseTypeChangeRestDTO.getEmailID().isEmpty()) {
						tradeLicenseTypeChange.setEmailID(tradeLicenseTypeChangeRestDTO.getEmailID());
					} else {
						String Email = "Email Id field is Required";
						condition = false;
						message.append(Email).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getMobileNumber() != 0) {
						tradeLicenseTypeChange.setMobileNumber(String.valueOf(tradeLicenseTypeChangeRestDTO.getMobileNumber()));
						} else {
						String MobileNo = "Mobile No field is Required";
						condition = false;
						message.append(MobileNo).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getAdressForCorrespondence() != null
							&& !tradeLicenseTypeChangeRestDTO.getAdressForCorrespondence().isEmpty()) {
						tradeLicenseTypeChange.setAdressForCorrespondence(tradeLicenseTypeChangeRestDTO.getAdressForCorrespondence());
						} else {
						String Address = "Address field is Required";
						condition = false;
						message.append(Address).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getZoneNo() != 0) {
						tradeLicenseTypeChange.setZoneNo(String.valueOf(tradeLicenseTypeChangeRestDTO.getZoneNo()));
						} else {
						String ZoneNo = "Zone No field is Required";
						condition = false;
						message.append(ZoneNo).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getWardNo() != null
							&& !tradeLicenseTypeChangeRestDTO.getWardNo().isEmpty()) {
						tradeLicenseTypeChange.setWardNo(tradeLicenseTypeChangeRestDTO.getWardNo());
						} else {
						String WardNo = "Ward No field is Required";
						condition = false;
						message.append(WardNo).append(",");
					}
					tradeLicenseTypeChange.setNameOfArea(tradeLicenseTypeChangeRestDTO.getNameOfArea());
									
						tradeLicenseTypeChange.setUpdateTradeName(tradeLicenseTypeChangeRestDTO.getUpdatedTradeName());
						
					if (tradeLicenseTypeChangeRestDTO.getUpdatedTradeType() != null
							&& !tradeLicenseTypeChangeRestDTO.getUpdatedTradeType().isEmpty()) {
						tradeLicenseTypeChange.setUpdatedTradeType(tradeLicenseTypeChangeRestDTO.getUpdatedTradeType());
						} else {
						String UpdatedTradeType = "UpdatedTradeType field is Required";
						condition = false;
						message.append(UpdatedTradeType).append(",");
					}
										
					if (tradeLicenseTypeChangeRestDTO.getUpdatedOwnerName() != null
							&& !tradeLicenseTypeChangeRestDTO.getUpdatedOwnerName().isEmpty()) {
						tradeLicenseTypeChange.setUpdatedOwnerName(tradeLicenseTypeChangeRestDTO.getUpdatedOwnerName());
						} else {
						String UpdatedOwnerName = "UpdatedOwnerName field is Required";
						condition = false;
						message.append(UpdatedOwnerName).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getUpdatedPartnerCount() != null
							&& !tradeLicenseTypeChangeRestDTO.getUpdatedPartnerCount().isEmpty()) {
						tradeLicenseTypeChange.setUpdatedPartnerCount(tradeLicenseTypeChangeRestDTO.getUpdatedPartnerCount());
						} else {
						String UpdatedPartnerCount = "UpdatedPartnerCount field is Required";
						condition = false;
						message.append(UpdatedPartnerCount).append(",");
					}
					
					if (tradeLicenseTypeChangeRestDTO.getFeesApplicable() != 0.0
							|| tradeLicenseTypeChangeRestDTO.getFeesApplicable() != 0) {
						tradeLicenseTypeChange.setFeesApplicable(tradeLicenseTypeChangeRestDTO.getFeesApplicable());
					} else {
						String feesApplicable = "Fees Applicable field is Required";
						condition = false;
						message.append(feesApplicable).append(",");
					}
					
					RTIApplication rtiApplication = new RTIApplication();

					if (tradeLicenseTypeChangeRestDTO.getUserMobileNumber() !=0) {
						rtiApplication.setMobileAppUserNumber(String.valueOf(tradeLicenseTypeChangeRestDTO.getUserMobileNumber()));
						} else {
						String userMobilenumber = "User Mobile Number field is Required";
						condition = false;
						message.append(userMobilenumber).append(",");
					}
					if (tradeLicenseTypeChangeRestDTO.getNocForRelatedDepartment() != null
							&& !tradeLicenseTypeChangeRestDTO.getNocForRelatedDepartment()
									.isEmpty()) {
						String doc1 = tradeLicenseTypeChangeRestDTO.getNocForRelatedDepartment();

						files[0] = doc1;
					} else {
						String doc1 = "NocForRelatedDepartment field is Required";
						condition = false;
						message.append(doc1).append(",");
					}
					
					if (tradeLicenseTypeChangeRestDTO.getCopyOfFormerLicence() != null
