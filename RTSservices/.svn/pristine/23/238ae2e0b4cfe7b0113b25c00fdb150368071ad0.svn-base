						rtiApplication.setSubject("TRADE-LICENSE-TYPE-CHANGE");
						rtiApplication.setTemplateName("tradeLicenseTypeChangeApplication");
						rtiApplication.setDepartment("MARKET-DEPARTMENT");
						rtiApplication.setWorkFlowStatus(0);
						rtiApplication.setFinalStatus("0");
						rtiApplication.setRtiserviceid(35);
						rtiApplication.setApplicantName(tradeLicenseTypeChange.getFullName());
						rtiApplication.setPhoneNumber(tradeLicenseTypeChange.getMobileNumber());
						rtiApplication.setMobileNumber(tradeLicenseTypeChange.getMobileNumber());
						rtiApplication.setEmail(tradeLicenseTypeChange.getEmailID());
						rtiApplication.setPdfUploadFromPortal(savedFilePath);
						rtiApplication.setZone(tradeLicenseTypeChange.getZoneNo());

						rtiApplication.setApplicationCost(tradeLicenseTypeChange.getFeesApplicable());

