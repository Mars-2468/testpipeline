package com.mars.rti.service.impl;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.mars.rti.dao.PurposeofwaterconnectionDAO;
import com.mars.rti.model.Purposeofwaterconnection;
import com.mars.rti.service.PurposeofwaterconnectionService;

@Service
public class PurposeofwaterconnectionServiceImpl  implements PurposeofwaterconnectionService  {
	
	@Autowired
	private PurposeofwaterconnectionDAO purposeofwaterconnectionDAO;

	@Override
	public List<Purposeofwaterconnection> getPurposeofwaterconnections() {
		// TODO Auto-generated method stub
		return  purposeofwaterconnectionDAO.getPurposeofwaterconnections();
	}

	
	

}
