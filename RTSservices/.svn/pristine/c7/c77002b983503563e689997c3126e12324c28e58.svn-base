package com.mars.rti.model;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.GenerationType;
import javax.persistence.Id;
import javax.persistence.SequenceGenerator;
import javax.persistence.Table;

@Entity
@Table(name = "zonecrematious", schema = "egovcommon")

public class ZoneCrematious {
	@Id
	@Column(name = "zonecrematiousid", nullable = false, unique = true)
	@SequenceGenerator(name = "zonecrematious_seq", sequenceName = "zonecrematious_seq")
	@GeneratedValue(strategy = GenerationType.SEQUENCE, generator = "zonecrematious_seq")
	
	private long zonecrematiousid;
	
	@Column(name ="zonecrematiousname")
	private String zonecrematiousname;
	
	@Column(name ="zoneid")
	private long zoneid;

	public long getZonecrematiousid() {
		return zonecrematiousid;
	}

	public void setZonecrematiousid(long zonecrematiousid) {
		this.zonecrematiousid = zonecrematiousid;
	}

	public String getZonecrematiousname() {
		return zonecrematiousname;
	}

	public void setZonecrematiousname(String zonecrematiousname) {
		this.zonecrematiousname = zonecrematiousname;
	}

	public long getZoneid() {
		return zoneid;
	}

	public void setZoneid(long zoneid) {
		this.zoneid = zoneid;
	}
	
	
	
}
