	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="egvNmc"/>
	<queryString>
		<![CDATA[WITH cte AS (
  SELECT ra.*, gmp.*,
    CASE 
      WHEN ra.workflow_status IN (2, 1) THEN 'Yes'
      ELSE 'No'
    END AS demandpaid,

    CASE 
      WHEN ra.workflow_status = 3 THEN 'Yes'
      ELSE 'No'
    END AS demandsend,

    CASE 
      WHEN gmp.police_noc IS NOT NULL 
        AND gmp.traffic_noc IS NOT NULL 
        AND gmp.fire_noc IS NOT NULL THEN 'Yes'
      ELSE 'No'
    END AS nocstatus

  FROM egovrti.rti_application ra
  JOIN egovrti.ganesh_mandap_permission gmp
  ON gmp.rti_ref_id = ra.rti_application_id
  WHERE gmp.rti_ref_id = ra.rti_application_id
    AND ra.rti_application_number IS NOT NULL
    AND ra.rti_application_number != ''
)
SELECT *
FROM cte
ORDER BY zone_no ASC;]]>
	</queryString>
