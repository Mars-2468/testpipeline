package com.mars.workflow.model;

public class WorkflowTaskTransition implements java.io.Serializable {
	public String id = "";
	public String name = "";
	public String toTaskName="";

	public String getId() {
		return id;
	}

	public void setId(String id) {
		this.id = id;
	}

	public String getName() {
		return name;
	}

	public void setName(String name) {
		this.name = name;
	}

	/**
	 * @return the toTaskName
	 */
	public String getToTaskName() {
		return toTaskName;
	}

	/**
	 * @param toTaskName the toTaskName to set
	 */
	public void setToTaskName(String toTaskName) {
		this.toTaskName = toTaskName;
	}
	
}
