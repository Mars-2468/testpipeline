package com.mars.common.utils;

public class ApplicationSettings
{
	 public static String classForName;

	    public static String reportDBUser;

	    public static String reportDBPassword;

	    public static String reportDBURL;

	    public static String reportsDirectory;
	    
	    public static String mailUserName;
	    
	    public static String mailPassWord;
	    
	    public static String mailSubject;
	    
	    public static String mailSender;
	    
	    public static String mailSmtpAuth;
	    
	    public static String mailSmtpHost;
	    
	    public static String mailSmtpPort;
	    
	    public static String mailSmtpStartTlsEnable;
	    
	    public static String mailSendAfterSpecificPeriod;
	    
	
	
	
	public static String gisServerUrl;
    
    public static String restServiceUserName;
    
    public static String restServicePassword;
    
    public static String fasServerUrl;
    
    public static String fasServerUserName;
    
    public static String fasServerPassword;
    
    public static String restAccountsRentalServiceUserName;
    
    public static String restAccountsRentalServicePassword;
    
    

	public static String getGisServerUrl() {
		return gisServerUrl;
	}

	public static void setGisServerUrl(String gisServerUrl) {
		ApplicationSettings.gisServerUrl = gisServerUrl;
	}

	public static String getRestServiceUserName() {
		return restServiceUserName;
	}

	public static void setRestServiceUserName(String restServiceUserName) {
		ApplicationSettings.restServiceUserName = restServiceUserName;
	}

	public static String getRestServicePassword() {
		return restServicePassword;
	}

	public static void setRestServicePassword(String restServicePassword) {
		ApplicationSettings.restServicePassword = restServicePassword;
	}

	public static String getFasServerUrl() {
		return fasServerUrl;
	}

	public static void setFasServerUrl(String fasServerUrl) {
		ApplicationSettings.fasServerUrl = fasServerUrl;
	}

	public static String getFasServerUserName() {
		return fasServerUserName;
	}

	public static void setFasServerUserName(String fasServerUserName) {
		ApplicationSettings.fasServerUserName = fasServerUserName;
	}

	public static String getFasServerPassword() {
		return fasServerPassword;
	}

	public static void setFasServerPassword(String fasServerPassword) {
		ApplicationSettings.fasServerPassword = fasServerPassword;
	}

	public static String getRestAccountsRentalServiceUserName() {
		return restAccountsRentalServiceUserName;
	}

	public static void setRestAccountsRentalServiceUserName(
			String restAccountsRentalServiceUserName) {
		ApplicationSettings.restAccountsRentalServiceUserName = restAccountsRentalServiceUserName;
	}

	public static String getRestAccountsRentalServicePassword() {
		return restAccountsRentalServicePassword;
	}

	public static void setRestAccountsRentalServicePassword(
			String restAccountsRentalServicePassword) {
		ApplicationSettings.restAccountsRentalServicePassword = restAccountsRentalServicePassword;
	}
   
	
    
}
