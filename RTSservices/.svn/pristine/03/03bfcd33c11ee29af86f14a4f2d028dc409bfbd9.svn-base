package com.mars.rti.ws.model;
import java.io.Serializable;
import java.util.List;

import com.fasterxml.jackson.annotation.JsonPropertyOrder;
import com.mars.rti.model.ReasonForTreeTrimming;
@SuppressWarnings("serial")
@JsonPropertyOrder({ "reasonfortreetrimming", "response", "responseStatus" })

public class ReasonForTreeTrimmingRestDTO  implements Serializable {
	
private List<ReasonForTreeTrimming> reasonForTreeTrimming;
	
	private String responseStatus;

	private long response;

	public List<ReasonForTreeTrimming> getReasonForTreeTrimming() {
		return reasonForTreeTrimming;
	}

	public String getResponseStatus() {
		return responseStatus;
	}

	public long getResponse() {
		return response;
	}

	public void setReasonForTreeTrimming(List<ReasonForTreeTrimming> reasonForTreeTrimming) {
		this.reasonForTreeTrimming = reasonForTreeTrimming;
	}

	public void setResponseStatus(String responseStatus) {
		this.responseStatus = responseStatus;
	}

	public void setResponse(long response) {
		this.response = response;
	}

	
	
}
