	// Property Upload
	@RequestMapping("/rtsapplication/uploadPropertyWaterNoDuesCertificate.do")
	public void uploadPropertyWaterNoDuesCertificate(HttpServletRequest request, HttpServletResponse response)
			throws IOException {

		JSONObject json = new JSONObject();
		PrintWriter pw = response.getWriter();
		RTIApplication rtiApplication = null;
		String BaseDir = null;
		String[] name = new String[12];
		String idName = "";
		String uniqueId = request.getParameter("UID");
		BaseDir = CoreConstants.UPLOAD_PATH + "WaterNoDuesUpload";
		if (uniqueId != null) {
			BaseDir = BaseDir + File.separator + uniqueId;
		}
		try {

			DiskFileItemFactory factory = new DiskFileItemFactory();
			factory.setSizeThreshold(MAX_FILE_SIZE);
			factory.setRepository(new File(System.getProperty("java.io.tmpdir")));

			ServletFileUpload upload = new ServletFileUpload(factory);

			List formItems = upload.parseRequest(request);
			Iterator iter = formItems.iterator();
			int i = 0;
			while (iter.hasNext()) {
				FileItem item = (FileItem) iter.next();

				System.out.println("i@@@@@@");
				String fileName = new File(item.getName()).getName();
				int l = fileName.lastIndexOf(".");
				String imageext = fileName.substring(l, fileName.length());
				fileName = fileName.substring(0, l);
				fileName = fileName.replaceAll("\\W", "");
				fileName = fileName + "" + imageext;
				name[i] = item.getName();

				String filePath = BaseDir + File.separator + i + fileName;
				File storeFile = new File(filePath);
				File parentDirectory = storeFile.getParentFile();
				if (!parentDirectory.exists()) {
					parentDirectory.mkdirs();
				}

				item.write(storeFile);
				request.setAttribute("idProofRequired", false);

//				String url = "https" + "://" + request.getServerName() + request.getRequestURI() + "?"
//						+ request.getQueryString();
//				String[] url1 = url.split("/rtsapplication");
				String url = CoreConstants.UPLOAD_PATH;
				String httppath = url + File.separator + "WaterNoDuesUpload" + File.separator + uniqueId
						+ File.separator + i + fileName;

				rtiApplication = rTIApplicationService.get(Long.parseLong(uniqueId));
				rtiApplication.setPdfFilesSavedPath(httppath);
				rtiApplication.setWorkFlowStatus(1);
				rtiApplication = rTIApplicationService.merge(rtiApplication);
				SendSMSEmailController.sendApplicationCompleted(rtiApplication.getApplicantName(),
						rtiApplication.getPhoneNumber(), rtiApplication.getRtiApplnNumber(), rtiApplication.getEmail());
				request.setAttribute("rtiApplication", rtiApplication);
				i++;
				json.put("status", true);
				pw.print(json.toString());
				pw.flush();
			}

		} catch (Exception ex) {
			ex.printStackTrace();
			json.put("status", false);
			pw.print(json.toString());
			pw.flush();
		}

	}

	// New Download Method
	@RequestMapping("/rtsApplication/getPdf.do")
	public void getPdf(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		String decodedFilesPath = new String(Base64.getDecoder().decode(request.getParameter("fp")),
				StandardCharsets.UTF_8);
		String filePath = URLDecoder.decode(decodedFilesPath, "UTF-8");

		displayPdf(filePath, response);
	}

	private void displayPdf(String filePath, HttpServletResponse response) throws IOException {

		File file = new File(filePath);
		String fileExtension = "";
		String contentType = "";

		if (file.exists()) {
			try (InputStream inputStream = new FileInputStream(file)) {
				int dotIndex = file.getName().lastIndexOf('.');
				if (dotIndex != -1 && dotIndex < file.getName().length() - 1) {
					fileExtension = file.getName().substring(dotIndex + 1).toLowerCase();
				}
				if (fileExtension.equalsIgnoreCase("jpg")) {
					contentType = "image/jpg";
				} else if (fileExtension.equalsIgnoreCase("jpeg")) {
					contentType = "image/jpeg";
				} else if (fileExtension.equalsIgnoreCase("png")) {
					contentType = "image/png";
				} else {
					contentType = "application/pdf";
				}
				response.setContentType(contentType);
				log.debug("File Name=" + file.getName());
				response.setHeader("Content-Disposition", "inline;filename=" + file.getName());

				byte[] buffer = new byte[4096];
				int bytesRead;
				while ((bytesRead = inputStream.read(buffer)) != -1) {
					response.getOutputStream().write(buffer, 0, bytesRead);
				}
				log.debug("PDF content has been successfully displayed.");
			} catch (IOException e) {
				log.error(e.getMessage());
				response.getWriter().println("Error: " + e.getMessage());
			}
		} else {
			response.sendError(HttpServletResponse.SC_NOT_FOUND);
			log.debug(filePath);
		}
	}

