								request.getQueryString();
						String[] url1 = url.split("/rtsapplication");
						String httppath = url1[0] + "/DemandUpload/" + uniqueId + "/DemandUpload/" + i + fileName;
						WaterPressure waterPressure = waterPressureService.get(Long.parseLong(uniqueId));
						waterPressure.setUploadedDemand(httppath);
						waterPressureService.saveWaterConnectionType(waterPressure);
						// }
					} else if (appType.equals("2")) {
						filePath = BaseDir + "AcknowledgementUpload/" + File.separator + i + fileName;
						File storeFile = new File(filePath);
						// saves the file on disk
						File parentDirectory = storeFile.getParentFile();
						if (!parentDirectory.exists()) {
