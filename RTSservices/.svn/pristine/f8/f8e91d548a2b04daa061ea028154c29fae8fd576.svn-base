						WaterQualityComplaint waterQualityComplaint = waterQualityComplaintService
								.get(Long.parseLong(uniqueId));
						waterQualityComplaint.setUploadedDemand(httppath);
						waterQualityComplaintService.saveWaterQualityComplaintForm(waterQualityComplaint);
