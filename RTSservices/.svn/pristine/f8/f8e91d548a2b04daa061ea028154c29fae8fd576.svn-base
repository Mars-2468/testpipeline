	@RequestMapping("/rtiapplication/downLoadAttachment.do")
	public void downLoadAttachment(HttpServletRequest request, HttpServletResponse response)
			throws ServletException, IOException {
		HttpSession session = request.getSession();

		String filePath = null;
		String id = request.getParameter("id");
		String attachementName = request.getParameter("attachementName");
		// attachementName=attachementName.concat(".pdf");
		String licAppliNo = request.getParameter("licAppliNo");
		String serviceId = request.getParameter("serId");

		if (serviceId != null && serviceId.length() > 0) {
			if (serviceId.equals("1")) {
				filePath = getServletContext().getRealPath("") + "/BirthUpload/" + licAppliNo + "/" + id + "/"
						+ attachementName.trim();
			}
			/*
			 * if(serviceId.equals("20;")){ filePath = getServletContext().getRealPath("")
			 * +"/DebriesPermissionUploads/"+licAppliNo+"/"+id+"/"+ attachementName; }
			 * if(serviceId.equals("21")){ filePath = getServletContext().getRealPath("")
			 * +"/CommunitycenterUploads/"+licAppliNo+"/"+id+"/"+ attachementName; }
			 * if(serviceId.equals("22")){ filePath = getServletContext().getRealPath("")
			 * +"/FestivalpandalUploads/"+licAppliNo+"/"+id+"/"+attachementName; }
			 * if(serviceId.equals("27")){ filePath = getServletContext().getRealPath("")
			 * +"/RoaddiggingUploads/"+licAppliNo+"/"+id+"/"+attachementName; }
			 * if(serviceId.equals("33")){ filePath = getServletContext().getRealPath("")
			 * +"/StallfordiwaliUploads/"+licAppliNo+"/"+id+"/"+attachementName; }
			 * if(serviceId.equals("30")){ filePath = getServletContext().getRealPath("")
			 * +"/stagepandalingroundUploads/"+licAppliNo+"/"+id+"/"+ attachementName; }
			 * if(serviceId.equals("31")){ filePath = getServletContext().getRealPath("")
			 * +"/suctionjettinguploads/"+licAppliNo+"/"+id+"/"+attachementName; }
			 */
		}

		File downloadFile = new File(filePath);
		FileInputStream inStream = new FileInputStream(downloadFile);

		// if you want to use a relative path to context root:
		String relativePath = getServletContext().getRealPath("");
		System.out.println("relativePath = " + relativePath);

		// obtains ServletContext
		ServletContext context = getServletContext();

		// gets MIME type of the file
		String mimeType = context.getMimeType(filePath);
		if (mimeType == null) {
			// set to binary type if MIME mapping not found
			mimeType = "application/octet-stream";
		}
		System.out.println("MIME type: " + mimeType);

		// modifies response
		response.setContentType(mimeType);
		response.setContentLength((int) downloadFile.length());

		// forces download
		String headerKey = "Content-Disposition";
		String headerValue = String.format("attachment; filename=\"%s\"", downloadFile.getName());
		response.setHeader(headerKey, headerValue);

		// obtains response's output stream
		OutputStream outStream = response.getOutputStream();

		byte[] buffer = new byte[4096];
		int bytesRead = -1;

		while ((bytesRead = inStream.read(buffer)) != -1) {
			outStream.write(buffer, 0, bytesRead);
		}

		inStream.close();
		outStream.close();
	}

	public void setUploadDocsOnEditMode(HttpServletRequest request, ServletContext servletContext,
			String applicationType, long id) {

		String appNum = String.valueOf(id);
		String mainDir = null;

		if (appNum != null && !appNum.equals("0")) {

			if (applicationType.equals("BirthRegistration"))
				mainDir = getServletContext().getRealPath("") + "/BirthUpload/" + appNum + "/";
			if (applicationType.equals("DEBRIESPERMISSION"))
				mainDir = getServletContext().getRealPath("") + "/DebriesPermissionUploads/" + appNum + "/";
			if (applicationType.equals("COMMUNITYCENTER"))
				mainDir = getServletContext().getRealPath("") + "/CommunitycenterUploads/" + appNum + "/";
			if (applicationType.equals("FESTIVALPANDAL"))
				mainDir = getServletContext().getRealPath("") + "/FestivalpandalUploads/" + appNum + "/";
