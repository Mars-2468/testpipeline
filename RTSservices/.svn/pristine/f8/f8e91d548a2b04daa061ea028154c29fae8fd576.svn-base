	@RequestMapping(method = RequestMethod.POST, value = "/rtsapplication/getDogApplicationDetails.do")
	public void getDogApplicationDetails(HttpServletRequest request, HttpServletResponse response)
			throws ServletException, IOException {
		HttpSession session = request.getSession();
		DogLicenseCertificate dogLicenseCertificate = null;
		List<DogDetails> dogDetailsList = new ArrayList<>();
		List<DogDetailsDTO> dddtolist = new ArrayList<>();
		DateFormat dateFormat = new SimpleDateFormat("dd/MM/yyyy HH:mm:ss");
		Date date = new Date();
		PrintWriter out = response.getWriter();
		JSONObject json = new JSONObject();

		try {
			String renewalDog = request.getParameter("renewaldog");
			RTIApplication rts = rTIApplicationService.findByRTIApplicationNumber(renewalDog);

			if (rts != null) {
				dogLicenseCertificate = dogLicenceCertificateService.get(rts.getRtiApplicationRefId());
				dogDetailsList = dogLicenseCertificate.getDogDetails();

				if (dogLicenseCertificate != null && dogDetailsList != null) {
					if (dogLicenseCertificate.getRenewalStatus() == 0) {
						long time = checkDogRenewalTime(dateFormat.format(date),
								dogLicenseCertificate.getCertificate_issued(), dateFormat);
						if (time >= 365) {
							for (DogDetails dd : dogDetailsList) {
								DogDetailsDTO dddto = new DogDetailsDTO();
								BeanUtils.copyProperties(dddto, dd);
								dddtolist.add(dddto);
							}

							DogLicenseDTO dldto = new DogLicenseDTO();
							BeanUtils.copyProperties(dldto, dogLicenseCertificate);
							ObjectMapper om = new ObjectMapper();
							String json1 = om.writeValueAsString(dddtolist);
							ObjectMapper om1 = new ObjectMapper();
							String json2 = om1.writeValueAsString(dldto);
							json.put("dogLicenseCertificate", json1);
							json.put("dogDetailsList", json2);

							response.setContentType("application/json");
							response.setCharacterEncoding("UTF-8");
							json.put("status", true);
							out.print(json.toString());
							out.flush();

						} else {
							json.put("status", "_");
							json.put("renewal", false);
							out.print(json.toString());
							out.flush();
						}

					} else {
						json.put("status", "_");
						json.put("renewal_status", false);
						out.print(json.toString());
						out.flush();

					}
				} else {
					json.put("status", false);
					out.print(json.toString());
					out.flush();
				}

			} else {
				json.put("status", false);
				out.print(json.toString());
				out.flush();
			}
		} catch (NumberFormatException e) {
			response.setStatus(HttpServletResponse.SC_BAD_REQUEST);
			e.printStackTrace();
		} catch (Exception e) {
			response.setStatus(HttpServletResponse.SC_INTERNAL_SERVER_ERROR);
			e.printStackTrace();
		}
	}

	public long checkDogRenewalTime(String date2, String date1, DateFormat dateFormat) {

		Date d1 = null;
		Date d2 = null;
		try {
			d1 = dateFormat.parse(date1);
			d2 = dateFormat.parse(date2);

			long diff = d2.getTime() - d1.getTime();

			// in milliseconds
			long diffDays = diff / (24 * 60 * 60 * 1000);

			return diffDays;
		} catch (Exception e) {
			e.printStackTrace();
		}
		return 0;

	}

