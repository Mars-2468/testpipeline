	@RequestMapping("/rtsapplication/uploadGaneshMandapNoc.do")
	public void uploadGaneshMandapNoc(HttpServletRequest request, HttpServletResponse response) throws IOException {

		JSONObject json = new JSONObject();
		PrintWriter pw = response.getWriter();
		String BaseDir = null;
		String appType = request.getParameter("appType");

		if (appType.equals("1"))
			BaseDir = CoreConstants.UPLOAD_PATH + "PoliceNOCUpload";
		if (appType.equals("2"))
			BaseDir = CoreConstants.UPLOAD_PATH + "FireNOCUpload";
		if (appType.equals("3"))
			BaseDir = CoreConstants.UPLOAD_PATH + "TrafficNOCUpload";

		String uniqueId = request.getParameter("UID");

		if (uniqueId != null) {
			BaseDir = BaseDir + File.separator + uniqueId;
		}

		// Common Directories for all Dog licenses
		File BillReceiptDoc;
		File dogPhoto;
		File inspectionOnereport;
		File inspectionTworeport;
		File policenoc;

		// common dir for all permissions
		File mapofplace;
		File psnoc;

		File concert;
		File placenoc;
		File firenoc;

		File trafficnoc;
		File file = new File(BaseDir);

		String[] name = new String[12];
		String idName = "";

		if (FileUpload.isMultipartContent(request)) {
			try {
				System.out.println("i@@@@@@");
				// parses the request's content to extract file data
				DiskFileItemFactory factory = new DiskFileItemFactory();
				factory.setSizeThreshold(MAX_FILE_SIZE);
				factory.setRepository(new File(System.getProperty("java.io.tmpdir")));

				ServletFileUpload upload = new ServletFileUpload(factory);
				// upload.setFileSizeMax(MAX_FILE_SIZE);
				// upload.setSizeMax(REQUEST_SIZE);

				List formItems = upload.parseRequest(request);
				Iterator iter = formItems.iterator();
				int i = 0;
				// iterates over form's fields
				while (iter.hasNext()) {
					FileItem item = (FileItem) iter.next();
					// processes only fields that are not form fields
					// if (!item.isFormField() && !item.getName().isEmpty() &&
					// item.getName()!=null)
					// {
					System.out.println("i@@@@@@");
					String fileName = new File(item.getName()).getName();
					int l = fileName.lastIndexOf(".");
					String imageext = fileName.substring(l, fileName.length());
					fileName = fileName.substring(0, l);
					fileName = fileName.replaceAll("\\W", "");
					fileName = fileName + "" + imageext;
					name[i] = item.getName();
					String filePath;
					if (appType.equals("1")) {
						filePath = BaseDir + File.separator + i + fileName;
						File storeFile = new File(filePath);
						// saves the file on disk
						File parentDirectory = storeFile.getParentFile();
						if (!parentDirectory.exists()) {
							parentDirectory.mkdirs(); // Creates parent directories if they don't exist
						}

						// Now save the file
						item.write(storeFile);
						request.setAttribute("idProofRequired", false);
						// String url = request.getRequestURL() + "?" +
						// request.getQueryString();
//						String url = "https" + "://" + // "http" + "://
//								request.getServerName() + request.getRequestURI() + // "/people"
//								"?" + // "?"
//								request.getQueryString();
//						String[] url1 = url.split("/rtsapplication");				
						String url = CoreConstants.UPLOAD_PATH;
						String httppath = url + "PoliceNOCUpload" + File.separator + uniqueId + File.separator + i
								+ fileName;
						GaneshMandapPermission ganeshMandapPermission = ganeshMandapPermissionService
								.get(Long.parseLong(uniqueId));
						ganeshMandapPermission.setPoliceNoc(httppath);
						ganeshMandapPermissionService.saveGaneshMandapForm(ganeshMandapPermission);
						RTIApplication application = rTIApplicationService.get(ganeshMandapPermission.getRti_ref_id());
						application.setPoliceNoc(httppath);
						rTIApplicationService.merge(application);
						// }
					} else if (appType.equals("2")) {
						filePath = BaseDir + File.separator + i + fileName;
						File storeFile = new File(filePath);
						// saves the file on disk
						File parentDirectory = storeFile.getParentFile();
						if (!parentDirectory.exists()) {
							parentDirectory.mkdirs(); // Creates parent directories if they don't exist
						}

						// Now save the file
						item.write(storeFile);
						request.setAttribute("idProofRequired", false);
						// String url = request.getRequestURL() + "?" +
						// request.getQueryString();
//						String url = "https" + "://" + // "http" + "://
//								request.getServerName() + request.getRequestURI() + // "/people"
//								"?" + // "?"
//								request.getQueryString();
//						String[] url1 = url.split("/rtsapplication");
						String url = CoreConstants.UPLOAD_PATH;
						String httppath = url + "FireNOCUpload" + File.separator + uniqueId + File.separator + i
								+ fileName;
						GaneshMandapPermission ganeshMandapPermission = ganeshMandapPermissionService
								.get(Long.parseLong(uniqueId));
						ganeshMandapPermission.setFireNoc(httppath);
						ganeshMandapPermissionService.saveGaneshMandapForm(ganeshMandapPermission);
						RTIApplication application = rTIApplicationService.get(ganeshMandapPermission.getRti_ref_id());
						application.setFireNoc(httppath);
						rTIApplicationService.merge(application);
						// }
					} else if (appType.equals("3")) {
						filePath = BaseDir + File.separator + i + fileName;
						File storeFile = new File(filePath);
						// saves the file on disk
						File parentDirectory = storeFile.getParentFile();
						if (!parentDirectory.exists()) {
							parentDirectory.mkdirs(); // Creates parent directories if they don't exist
						}

						// Now save the file
						item.write(storeFile);
						request.setAttribute("idProofRequired", false);
						// String url = request.getRequestURL() + "?" +
						// request.getQueryString();
//						String url = "https" + "://" + // "http" + "://
//								request.getServerName() + request.getRequestURI() + // "/people"
//								"?" + // "?"
//								request.getQueryString();
//						String[] url1 = url.split("/rtsapplication");
						String url = CoreConstants.UPLOAD_PATH;
						String httppath = url + "TrafficNOCUpload" + File.separator + uniqueId + File.separator + i
								+ fileName;
						GaneshMandapPermission ganeshMandapPermission = ganeshMandapPermissionService
								.get(Long.parseLong(uniqueId));
						ganeshMandapPermission.setTrafficNoc(httppath);
						ganeshMandapPermissionService.saveGaneshMandapForm(ganeshMandapPermission);
						RTIApplication application = rTIApplicationService.get(ganeshMandapPermission.getRti_ref_id());
						application.setTrafficNoc(httppath);
						rTIApplicationService.merge(application);
						// }
					}

					json.put("status", true);
					PrintWriter out = response.getWriter();
					out.print(json.toString());
					out.flush();

				}
				request.setAttribute("message", "Upload has been done successfully!");
			} catch (Exception ex) {
				json.put("status", false);
				PrintWriter out = response.getWriter();
				out.print(json.toString());
				out.flush();

				request.setAttribute("message", "There was an error: " + ex.getMessage());
				ex.printStackTrace();
			}
		} else {
			json.put("status", false);
			PrintWriter out = response.getWriter();
			out.print(json.toString());
			out.flush();

			request.setAttribute("message", "Please contact the system admin");
		}

	}

