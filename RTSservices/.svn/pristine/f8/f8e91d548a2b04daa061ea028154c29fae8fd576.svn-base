	// Property Tax Payment Receipt
	@RequestMapping("//rtsapplication/savePropertyPaymentReceiptupload.do")
	public void savePropertyPaymentReceiptupload(HttpServletRequest request, HttpServletResponse response)
			throws IOException {
		JSONObject json = new JSONObject();
		String rtiapplicationId = request.getParameter("id");

		String propertyId = request.getParameter("propertyId");

		String baseDir = getServletContext().getRealPath("") + File.separator + "propertyTaxPaymentReceipt";
		if (rtiapplicationId != null) {
			baseDir = baseDir + "/" + rtiapplicationId;
		}
		File file = new File(baseDir);
		if (!file.exists()) {
			file.mkdirs();
		}
		String[] name = new String[12];

		if (FileUpload.isMultipartContent(request)) {
			try {
				System.out.println("i@@@@@@");
				DiskFileItemFactory factory = new DiskFileItemFactory();
				factory.setSizeThreshold(MAX_FILE_SIZE);
				factory.setRepository(new File(System.getProperty("java.io.tmpdir")));

				ServletFileUpload upload = new ServletFileUpload(factory);
				List formItems = upload.parseRequest(request);
				Iterator iter = formItems.iterator();
				int i = 0;
				while (iter.hasNext()) {
					FileItem item = (FileItem) iter.next();
					System.out.println("i@@@@@@");
					String fileName = new File(item.getName()).getName();
					int l = fileName.lastIndexOf(".");
					String imageext = fileName.substring(l, fileName.length());
					fileName = fileName.substring(0, l);
					fileName = fileName.replaceAll("\\W", "");
					fileName = fileName + "" + imageext;
					name[i] = item.getName();
					String filePath;

					filePath = baseDir + "/" + i + fileName;
					File storeFile = new File(filePath);
					File parentDirectory = storeFile.getParentFile();
					if (!parentDirectory.exists()) {
						parentDirectory.mkdirs();
					}

					item.write(storeFile);
					request.setAttribute("idProofRequired", false);
					String url = "https" + "://" + request.getServerName() + request.getRequestURI() + "?" + // "?"
							request.getQueryString();
					String[] url1 = url.split("/rtsapplication");
					String httppath = url1[0] + "/propertyTaxPaymentReceipt/" + rtiapplicationId + "/" + i + fileName;
					RTIApplication rtiApplication = rTIApplicationService.get(Long.parseLong(rtiapplicationId));
					if (propertyId.equals("1")) {
						PropertyTaxMutation propertyMutation = propertyTaxMutationService
								.getDetails(rtiApplication.getRtiApplicationId());
						propertyMutation.setPaymentReceipt(httppath);
						propertyMutation = propertyTaxMutationService.merge(propertyMutation);
					} else if (propertyId.equals("2")) {
						PropertyTaxTransferRegistration propertyTaxTransferRegistration = propertyTaxTransferRegistrationService
								.getDetails(rtiApplication.getRtiApplicationId());
						propertyTaxTransferRegistration.setPaymentReceipt(httppath);
						propertyTaxTransferRegistration = propertyTaxTransferRegistrationService
								.merge(propertyTaxTransferRegistration);
					} else if (propertyId.equals("3")) {
						PartitionOfProperty partitionofProproperty = partitionOfPropertyService
								.getDetails(rtiApplication.getRtiApplicationId());
						partitionofProproperty.setPaymentReceipt(httppath);
						partitionofProproperty = partitionOfPropertyService.merge(partitionofProproperty);
					} else if (propertyId.equals("4")) {
						NewlyConstructedProperty newlyConstructedProperty = newlyConstructedPropertyService
								.getDetails(rtiApplication.getRtiApplicationId());
						newlyConstructedProperty.setPaymentReceipt(httppath);
						newlyConstructedProperty = newlyConstructedPropertyService.merge(newlyConstructedProperty);
					} else if (propertyId.equals("5")) {
						PropertyTaxExemption propertyTaxExemption = taxExemptionService
								.getDetails(rtiApplication.getRtiApplicationId());
						propertyTaxExemption.setPaymentReceipt(httppath);
						propertyTaxExemption = taxExemptionService.merge(propertyTaxExemption);
					} else if (propertyId.equals("6")) {
						TaxExemptionNonResidential taxExemptionNonResidential = taxExemptionNonResidentialService
								.getDetails(rtiApplication.getRtiApplicationId());
						taxExemptionNonResidential.setPaymentReceipt(httppath);
						taxExemptionNonResidential = taxExemptionNonResidentialService
								.merge(taxExemptionNonResidential);
					} else if (propertyId.equals("7")) {
						PropertyAssessmentTrasScript propertyAssessmentTrasScript = propertyAssessmentService
								.getDetails(rtiApplication.getRtiApplicationId());
						propertyAssessmentTrasScript.setPaymentReceipt(httppath);
						propertyAssessmentTrasScript = propertyAssessmentService.merge(propertyAssessmentTrasScript);
					} else if (propertyId.equals("8")) {
						PropertyComplaintRegistration propertyComplaintRegistration = propertyTaxComplaintService
								.getDetails(rtiApplication.getRtiApplicationId());
						propertyComplaintRegistration.setPaymentReceipt(httppath);
						propertyComplaintRegistration = propertyTaxComplaintService
								.merge(propertyComplaintRegistration);
					}
					rtiApplication.setWorkFlowStatus(2);
					rtiApplication.setPropertyPaymentReceipt(httppath);
					rtiApplication = rTIApplicationService.merge(rtiApplication);
					json.put("status", true);
					PrintWriter out = response.getWriter();
					out.print(json.toString());
					out.flush();
					request.setAttribute("message", "Upload has been done successfully!");

				}
				request.setAttribute("message", "Upload has been done successfully!");
			} catch (Exception ex) {
				json.put("status", false);
				PrintWriter out = response.getWriter();
				out.print(json.toString());
				out.flush();
				request.setAttribute("message", "There was an error: " + ex.getMessage());
				ex.printStackTrace();
			}
		} else {
			json.put("status", false);
			PrintWriter out = response.getWriter();
			out.print(json.toString());
			out.flush();
			request.setAttribute("message", "Please contact the system admin");
		}

	}

