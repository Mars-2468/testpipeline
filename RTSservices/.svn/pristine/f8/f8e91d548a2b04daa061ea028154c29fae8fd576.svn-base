	@RequestMapping("ws/rtiapplication/newRTSFireRecommendationLetter.do")
	public ModelAndView newRTSFireRecommendationLetter(HttpServletRequest request, HttpServletResponse response)
			throws ServletException {
		request.getSession().removeAttribute("as_status");

		List<FireRecommendationTypeOfBuilding> fireRecommendationTypeOfBuilding = fireRecommendationTypeOfBuildingService
				.getTypeOfFireTypeOfBuilding();
		request.setAttribute("fireRecommendationTypeOfBuilding", fireRecommendationTypeOfBuilding);

		List<FireTypeOfConstruction> fireTypeOfConstruction = fireTypeOfConstructionService.getTypeOfConstruction();
		request.setAttribute("fireTypeOfConstruction", fireTypeOfConstruction);

		List<FireBuildingHeight> fireBuildingHeight = fireBuildingHeightService.getTypeOfBuildinhHeight();
		request.setAttribute("fireBuildingHeight", fireBuildingHeight);

		List<FireFloorName> fireFloorName = fireFloorNameService.getFireFloorName();
		request.setAttribute("fireFloorName", fireFloorName);

		List<SubTypeOfbuilding> subTypeOfbuilding = subTypeOfbuildingService.getSubTypeOfbuilding();
		request.setAttribute("subTypeOfbuilding", subTypeOfbuilding);

		List<FireDepartmentWiseLogin> fireDepartmentWiseLogin = fireDepartmentWiseLoginService
				.getFireDepartmentWiseLogin();
		request.setAttribute("fireDepartmentWiseLogin", fireDepartmentWiseLogin);

		List<FireSubDepartmentWiseLogin> fireSubDepartmentWiseLogin = fireSubDepartmentWiseLoginService
				.getFireSubDepartmentWiseLogin();
		request.setAttribute("fireSubDepartmentWiseLogin", fireSubDepartmentWiseLogin);

		List<FireFloorTypes> fireFloorTypes = fireFloorTypesService.getFireFloorTypes();
		request.setAttribute("fireFloorTypes", fireFloorTypes);

		ModelAndView modelAndView = new ModelAndView("newRTSFireRecommendationLetter");

		return modelAndView;
	}

	// Renewal Nurisng Home
	@RequestMapping(method = RequestMethod.POST, value = "/rtsapplication/getnursingApplicationDetails.do")
	public void getnursingApplicationDetails(HttpServletRequest request, HttpServletResponse response)
			throws ServletException, IOException {
		HttpSession session = request.getSession();
		NursingHomes nursingHomes = null;
		List<NurseDetails> nd = new ArrayList<>();
		List<SurgeonsDetails> sd = new ArrayList<>();
		List<NurseDetailsDTO> nddto = new ArrayList<>();
		List<SurgeonDetailsDTO> sddto = new ArrayList<>();
		DateFormat dateFormat = new SimpleDateFormat("dd/MM/yyyy HH:mm:ss");
		Date date = new Date();
		PrintWriter out = response.getWriter();
		JSONObject json = new JSONObject();

		try {
			String renewalNursingHome = request.getParameter("renewalNursingHome");
			RTIApplication rts = rTIApplicationService.findByRTIApplicationNumber(renewalNursingHome);

			if (rts != null) {
				nursingHomes = nursingHomesService.get(rts.getRtiApplicationRefId());
				nd = nursingHomes.getNd();
				sd = nursingHomes.getSd();

				if (nursingHomes != null && nd != null && sd != null) {
					long currentTime = checkNursingRenewalTime(dateFormat.format(date),
							nursingHomes.getCertificateIssuedDate(), dateFormat);
					long renewalTIme = checkNursingRenewalTime(dateFormat.format(date), nursingHomes.getRenewalDate(),
							dateFormat);
//					if (nursingHomes.getRenewalStatus() == 0) {
//						if (currentTime > 0 && renewalTIme > 0) {
//							if (currentTime >= renewalTIme) {
								for (NurseDetails nd1 : nd) {
									NurseDetailsDTO nddto1 = new NurseDetailsDTO();
									BeanUtils.copyProperties(nddto1, nd1);
									nddto.add(nddto1);

								}

								for (SurgeonsDetails sd1 : sd) {
									SurgeonDetailsDTO sddto1 = new SurgeonDetailsDTO();
									BeanUtils.copyProperties(sddto1, sd1);
									sddto.add(sddto1);

								}

								NursingHomeDTO nhto = new NursingHomeDTO();
								BeanUtils.copyProperties(nhto, nursingHomes);
								ObjectMapper om3 = new ObjectMapper();
								String json3 = om3.writeValueAsString(nhto);
								ObjectMapper om = new ObjectMapper();
								String json1 = om.writeValueAsString(nddto);
								ObjectMapper om1 = new ObjectMapper();
								String json2 = om1.writeValueAsString(sddto);
								json.put("nddto", json1);
								json.put("sddto", json2);
								json.put("nhdto", json3);

								response.setContentType("application/json");
								response.setCharacterEncoding("UTF-8");
								json.put("status", true);
								out.print(json.toString());
								out.flush();

							} else {
								json.put("status", "_");
								json.put("renewal", false);
								out.print(json.toString());
								out.flush();
							}

						} else {
							json.put("status", "_");
							json.put("renewal", false);
							out.print(json.toString());
							out.flush();
						}

//					} else {
//						json.put("status", "_");
//						json.put("renewal_status", false);
//						out.print(json.toString());
//						out.flush();
//
//					}
//
//				} else {
//					json.put("status", false);
//					out.print(json.toString());
//					out.flush();
//				}
//
//			} else {
//				json.put("status", false);
//				out.print(json.toString());
//				out.flush();
//			}
		} catch (NumberFormatException e) {
			response.setStatus(HttpServletResponse.SC_BAD_REQUEST);
			e.printStackTrace();
		} catch (Exception e) {
			response.setStatus(HttpServletResponse.SC_INTERNAL_SERVER_ERROR);
			e.printStackTrace();
		}
	}

	public long checkNursingRenewalTime(String date2, String date1, DateFormat dateFormat) {

		Date d1 = null;
		Date d2 = null;
		try {
			d1 = dateFormat.parse(date1);
			d2 = dateFormat.parse(date2);

			long diff = d2.getTime() - d1.getTime();

			// in milliseconds
			long diffDays = diff / (24 * 60 * 60 * 1000);

			return diffDays;
		} catch (Exception e) {
			e.printStackTrace();
		}
		return 0;

	}
	
	
	@RequestMapping("/rtsapplication/uploadManageMTP.do")
	public void uploadManageMTP(HttpServletRequest request,
			HttpServletResponse response) throws IOException {

		JSONObject json = new JSONObject();
		PrintWriter pw = response.getWriter();
		String BaseDir = null;
		String appType = request.getParameter("appType");

		if (appType.equals("1"))
			BaseDir = CoreConstants.UPLOAD_PATH + "InspectionUpload";
		
		String uniqueId = request.getParameter("UID");

		if (uniqueId != null) {
			BaseDir = BaseDir +File.separator+uniqueId;
		}

		// Common Directories for all Dog licenses
		File BillReceiptDoc;
		File dogPhoto;
		File inspectionOnereport;
		File inspectionTworeport;
		File policenoc;

		// common dir for all permissions
		File mapofplace;
		File psnoc;

		File concert;
		File placenoc;
		File firenoc;

		File trafficnoc;
		File file = new File(BaseDir);

		String[] name = new String[12];
		String idName = "";

		if (FileUpload.isMultipartContent(request)) {
			try {
				System.out.println("i@@@@@@");
				// parses the request's content to extract file data
				DiskFileItemFactory factory = new DiskFileItemFactory();
				factory.setSizeThreshold(MAX_FILE_SIZE);
				factory.setRepository(new File(System.getProperty("java.io.tmpdir")));

				ServletFileUpload upload = new ServletFileUpload(factory);
				// upload.setFileSizeMax(MAX_FILE_SIZE);
				// upload.setSizeMax(REQUEST_SIZE);

				List formItems = upload.parseRequest(request);
				Iterator iter = formItems.iterator();
				int i = 0;
				// iterates over form's fields
				while (iter.hasNext()) {
					FileItem item = (FileItem) iter.next();
					// processes only fields that are not form fields
					// if (!item.isFormField() && !item.getName().isEmpty() &&
					// item.getName()!=null)
					// {
					System.out.println("i@@@@@@");
					String fileName = new File(item.getName()).getName();
					int l = fileName.lastIndexOf(".");
					String imageext = fileName.substring(l, fileName.length());
					fileName = fileName.substring(0, l);
					fileName = fileName.replaceAll("\\W", "");
					fileName = fileName + "" + imageext;
					name[i] = item.getName();
					String filePath;
					if (appType.equals("1")) {
						filePath = BaseDir + File.separator + i + fileName;
						File storeFile = new File(filePath);
						// saves the file on disk
						File parentDirectory = storeFile.getParentFile();
						if (!parentDirectory.exists()) {
							parentDirectory.mkdirs(); // Creates parent directories if they don't exist
						}

						// Now save the file
						item.write(storeFile);
						request.setAttribute("idProofRequired", false);
						// String url = request.getRequestURL() + "?" +
						// request.getQueryString();
					
						String httppath = BaseDir+File.separator+ i + fileName;
						MTPRegistrationCertificate mTPRegistrationCertificate = mTPRegistrationCertificateService
								.get(Long.parseLong(uniqueId));
						mTPRegistrationCertificate.setUploadedDemand(httppath);
						mTPRegistrationCertificateService.saveMTP(mTPRegistrationCertificate);
						
						RTIApplication rts = rTIApplicationService.get(mTPRegistrationCertificate.getRti_ref_id());
						rts.setDemandletter(httppath);
						rTIApplicationService.save(rts);
						
						json.put("status", true);
						PrintWriter out = response.getWriter();
						out.print(json.toString());
						out.flush();
					} 
				}
				request.setAttribute("message", "Upload has been done successfully!");
			} catch (Exception ex) {
				json.put("status", false);
				PrintWriter out = response.getWriter();
				out.print(json.toString());
				out.flush();
				request.setAttribute("message", "There was an error: " + ex.getMessage());
				ex.printStackTrace();
			}
		} else {
			json.put("status", false);
			PrintWriter out = response.getWriter();
			out.print(json.toString());
			out.flush();
			request.setAttribute("message", "Please contact the system admin");
		}

		
	}
	
	
	@RequestMapping("/rtiapplication/mtpMedical.do")
	public void mtpMedical(HttpServletRequest request, HttpServletResponse response) throws IOException {
	    int id = Integer.parseInt(request.getParameter("id"));
	    log.info("Document Upload Attempted");
	    JSONObject json = new JSONObject();

	    try {
	        // Define the base directory for file uploads
	        String baseDir = CoreConstants.UPLOAD_PATH + "mtpMedical";

	        // Create the directory if it does not exist
	        File file = new File(baseDir);
	        if (!file.exists()) {
	            file.mkdirs();
	        }

	        // Check if the request contains multipart content
	        if (ServletFileUpload.isMultipartContent(request)) {
	            DiskFileItemFactory factory = new DiskFileItemFactory();
	            factory.setSizeThreshold(MAX_FILE_SIZE);
	            factory.setRepository(new File(System.getProperty("java.io.tmpdir")));

	            ServletFileUpload upload = new ServletFileUpload(factory);
	            upload.setFileSizeMax(MAX_FILE_SIZE);
	            upload.setSizeMax(REQUEST_SIZE);

	            List<FileItem> formItems = upload.parseRequest(request);
	            for (FileItem item : formItems) {
	                if (!item.isFormField() && item.getName() != null && !item.getName().isEmpty()) {
	                    String fileName = new File(item.getName()).getName();

	                    // Check file type
	                    if (!fileName.toLowerCase().endsWith(".pdf")) {
	                        json.put("status", false);
	                        json.put("message", "Only PDF files are allowed.");
	                        response.getWriter().print(json.toString());
	                        return;
	                    }

	                    // Check file size
	                    if (item.getSize() > 2 * 1024 * 1024) {
	                        json.put("status", false);
	                        json.put("message", "File size must be less than 2MB.");
	                        response.getWriter().print(json.toString());
	                        return;
	                    }

	                    // Remove invalid characters from the filename and add ID
	                    fileName = fileName.replaceAll("[^a-zA-Z0-9]", "").replaceAll("\\W", "");
	                    fileName = id + "_" + fileName + ".pdf"; // Add ID before the filename

	                    // Save the file
	                    File storeFile = new File(baseDir, fileName);
	                    item.write(storeFile);
	                }
	            }
	            json.put("status", true);
	            json.put("message", "File(s) uploaded successfully.");
	        } else {
	            json.put("status", false);
	            json.put("message", "The request does not contain multipart content.");
	        }
	    } catch (Exception ex) {
	        log.error("Error uploading file", ex);
	        json.put("status", false);
	        json.put("message", "An error occurred while uploading the file.");
	    } finally {
	        PrintWriter out = response.getWriter();
	        out.print(json.toString());
	        out.flush();
	    }
	}

	
