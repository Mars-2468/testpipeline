						String httppath = url1[0] + "/AcknowledgementUpload/" + uniqueId + "/AcknowledgementUpload/" + i
								+ fileName;

						WaterPressure waterPressure = waterPressureService.get(Long.parseLong(uniqueId));

						waterPressure.setAcknowledgement(httppath);
						waterPressureService.saveWaterConnectionType(waterPressure);
						// }

						RTIApplication rts = rTIApplicationService.get(waterPressure.getRti_ref_id());
						rts.setPdfFilesSavedPath(httppath);
						rTIApplicationService.save(rts);
					}

				}
				request.setAttribute("message", "Upload has been done successfully!");
			} catch (Exception ex) {
				request.setAttribute("message", "There was an error: " + ex.getMessage());
				ex.printStackTrace();
			}
		} else {
			request.setAttribute("message", "Please contact the system admin");
		}

		// request.setAttribute("licenseApplicationFormRestDTO",request.getAttribute("licenseApplicationFormRestDTO"));
		request.setAttribute("fileName", name);
		request.setAttribute("idName", idName);
		request.setAttribute("appType", appType);
		request.setAttribute("filePath", file.getAbsolutePath());
		request.setAttribute("SetEncType", false);

		request.setAttribute("serviceId", request.getParameter("serviceId"));
		// for download
		return new ModelAndView("manageWaterPressure");

	}

