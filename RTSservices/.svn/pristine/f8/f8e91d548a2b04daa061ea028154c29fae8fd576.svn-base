								.get(Long.parseLong(uniqueId));
						waterQualityComplaint.setAcknowledgement(httppath);
						waterQualityComplaintService.saveWaterQualityComplaintForm(waterQualityComplaint);
						// }

						RTIApplication rts = rTIApplicationService.get(waterQualityComplaint.getRti_ref_id());
						rts.setPdfFilesSavedPath(httppath);
						rTIApplicationService.save(rts);
					}

				}
