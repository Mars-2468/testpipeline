	@RequestMapping("/rtiapplication/uploadDocumentWaterMeterComplaint.do")
	public void uploadDocumentWaterMeterComplaint(HttpServletRequest request, HttpServletResponse response)
			throws IOException {
		int id = Integer.parseInt(request.getParameter("id"));
		log.info("Document Uploaded");
		JSONObject json = new JSONObject();

		try {
			String baseDir = getServletContext().getRealPath("") + File.separator + "waterMeterComplaint";
			File file = new File(baseDir);
			if (!file.exists()) {
