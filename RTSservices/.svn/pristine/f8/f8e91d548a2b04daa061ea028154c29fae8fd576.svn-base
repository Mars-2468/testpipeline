						// String url = request.getRequestURL() + "?" +
						// request.getQueryString();

						String httppath = BaseDir + File.separator + i + fileName;

						WaterConnectionTypeChange waterConnectionTypeChange = waterConnectionTypeChangeService
								.get(Long.parseLong(uniqueId));
						waterConnectionTypeChange.setAcknowledgement(httppath);
						waterConnectionTypeChangeService.saveWaterConnectionType(waterConnectionTypeChange);
