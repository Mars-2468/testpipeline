package com.mars.rti.model;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.Id;
import javax.persistence.Table;
@Entity
@Table(name="reasonfortreetrimming",schema="egovcommon")

public class ReasonForTreeTrimming {

	@Id
	@Column(name = "reasonfortreetrimmingid", nullable = false, unique = true)
	private long reasonfortreetrimmingid;
	
	@Column(name = "reasonfortreetrimming", nullable = false)
    private String reasonfortreetrimming;

	public long getReasonfortreetrimmingid() {
		return reasonfortreetrimmingid;
	}

	public String getReasonfortreetrimming() {
		return reasonfortreetrimming;
	}

	public void setReasonfortreetrimmingid(long reasonfortreetrimmingid) {
		this.reasonfortreetrimmingid = reasonfortreetrimmingid;
	}

	public void setReasonfortreetrimming(String reasonfortreetrimming) {
		this.reasonfortreetrimming = reasonfortreetrimming;
	}
	
	
}
