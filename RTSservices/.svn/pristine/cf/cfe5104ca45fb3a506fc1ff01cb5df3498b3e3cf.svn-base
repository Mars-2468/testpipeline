package com.mars.rti.ws.controller;
import java.util.ArrayList;
import java.util.List;

import javax.servlet.ServletException;
import javax.servlet.http.HttpServletResponse;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.ResponseBody;

import com.mars.rti.model.ZoneCrematious;
import com.mars.rti.service.ZoneCrematiousService;
import com.mars.rti.ws.model.ZoneCrematiousDTO;

@Controller
public class ZoneCrematiousController {
	
	@Autowired
	private ZoneCrematiousService zoneCrematiousService ;
	@RequestMapping(method = RequestMethod.GET, value ="/getAllZoneCrematiousList/{zoneNo}")
	public @ResponseBody ZoneCrematiousDTO 
	getAllZoneCrematiousList(@PathVariable String zoneNo,HttpServletResponse reponse) throws ServletException{

		ZoneCrematiousDTO zoneCrematiousDTO = new ZoneCrematiousDTO();
		List<ZoneCrematious> zoneCrematious = new ArrayList<ZoneCrematious>();
		zoneCrematious = zoneCrematiousService.getAllZoneCrematiousList(zoneNo);
		
		zoneCrematiousDTO.setZoneCrematious(zoneCrematious);
		return zoneCrematiousDTO;
		
	}
}


	
