package com.mars.rti.service.impl;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.mars.rti.dao.MarriageOccupationDAO;
import com.mars.rti.model.MarriageOccupation;
import com.mars.rti.service.MarriageOccupationService;

@Service
public class MarriageOccupationServiceImpl implements MarriageOccupationService{

	
	@Autowired
	private MarriageOccupationDAO marriageOccupationDAO;
	
	@Override
	public List<MarriageOccupation> getall() {
		// TODO Auto-generated method stub
		return marriageOccupationDAO.getall();
	}

	
	
}
