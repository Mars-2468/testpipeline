package com.mars.common.utils;

public class ApplicationSettingBean {

	public void setReportDBURL(String reportDBURL) {
		ApplicationSettings.reportDBURL = reportDBURL;
	}

	public void setReportDBUser(String reportDBUser) {
		ApplicationSettings.reportDBUser = reportDBUser;
	}

	public void setReportDBPassword(String reportDBPassword) {
		ApplicationSettings.reportDBPassword = reportDBPassword;
	}

	public void setClassForName(String classForName) {
		ApplicationSettings.classForName = classForName;
	}

	public void setReportsDirectory(String reportsDirectory) {
		ApplicationSettings.reportsDirectory = reportsDirectory;
	}

	public void setMailUserName(String mailUserName) {
		ApplicationSettings.mailUserName = mailUserName;
	}

	public void setmailPassWord(String mailPassWord) {
		ApplicationSettings.mailPassWord = mailPassWord;
	}

	public void setMailSubject(String mailSubject) {
		ApplicationSettings.mailSubject = mailSubject;
	}

	public void setMailSmtpAuth(String mailSmtpAuth) {
		ApplicationSettings.mailSmtpAuth = mailSmtpAuth;
	}

	public void setMailSmtpHost(String mailSmtpHost) {
		ApplicationSettings.mailSmtpHost = mailSmtpHost;
	}

	public void setMailSmtpPort(String mailSmtpPort) {
		ApplicationSettings.mailSmtpPort = mailSmtpPort;
	}

	public void setMailSmtpStartTlsEnable(String mailSmtpStartTlsEnable) {
		ApplicationSettings.mailSmtpStartTlsEnable = mailSmtpStartTlsEnable;
	}

	public void setMailSender(String mailSender) {
		ApplicationSettings.mailSender = mailSender;
	}

	public void setMailSendAfterSpecificPeriod(
			String mailSendAfterSpecificPeriod) {
		ApplicationSettings.mailSendAfterSpecificPeriod = mailSendAfterSpecificPeriod;
	}

	/**
	 * @param gisServerUrl
	 *            the gisServerUrl to set
	 */
	public void setGisServerUrl(String gisServerUrl) {
		ApplicationSettings.gisServerUrl = gisServerUrl;
	}

	/**
	 * @param restServiceUserName
	 *            the restServiceUserName to set
	 */
	public void setRestServiceUserName(String restServiceUserName) {
		ApplicationSettings.restServiceUserName = restServiceUserName;
	}

	/**
	 * @param restServicePassword
	 *            the restServicePassword to set
	 */
	public void setRestServicePassword(String restServicePassword) {
		ApplicationSettings.restServicePassword = restServicePassword;
	}

	/**
	 * @param fasServerUrl
	 *            the fasServerUrl to set
	 */
	public void setFasServerUrl(String fasServerUrl) {
		ApplicationSettings.fasServerUrl = fasServerUrl;
	}

	/**
	 * @param fasServerUserName
	 *            the fasServerUserName to set
	 */
	public void setFasServerUserName(String fasServerUserName) {
		ApplicationSettings.fasServerUserName = fasServerUserName;
	}

	/**
	 * @param fasServerPassword
	 *            the fasServerPassword to set
	 */
	public void setFasServerPassword(String fasServerPassword) {
		ApplicationSettings.fasServerPassword = fasServerPassword;
	}

	public static void setRestAccountsRentalServiceUserName(
			String restAccountsRentalServiceUserName) {
		ApplicationSettings.restAccountsRentalServiceUserName = restAccountsRentalServiceUserName;
	}

	public static void setRestAccountsRentalServicePassword(
			String restAccountsRentalServicePassword) {
		ApplicationSettings.restAccountsRentalServicePassword = restAccountsRentalServicePassword;
	}

}
