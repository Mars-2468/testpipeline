package com.mars.rti.ws.model;

import java.io.Serializable;

import javax.xml.bind.annotation.XmlElement;

import com.fasterxml.jackson.annotation.JsonPropertyOrder;

@SuppressWarnings("serial")
@JsonPropertyOrder({})
public class CitizenMyApplicationRest2DTO implements Serializable {
	
	private String rtiApplicationNo;
	
	private String subject;
	
	private String date;
	
	private String status;
	
	private String certificate;

	@XmlElement(name = "rtiApplicationNo")
	public String getRtiApplicationNo() {
		return rtiApplicationNo;
	}

	public void setRtiApplicationNo(String rtiApplicationNo) {
		this.rtiApplicationNo = rtiApplicationNo;
	}

	@XmlElement(name = "subject")
	public String getSubject() {
		return subject;
	}

	public void setSubject(String subject) {
		this.subject = subject;
	}

	@XmlElement(name = "date")
	public String getDate() {
		return date;
	}

	public void setDate(String date) {
		this.date = date;
	}

	@XmlElement(name = "status")
	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}
	
	@XmlElement(name = "certificate")
	public String getCertificate() {
		return certificate;
	}

	public void setCertificate(String certificate) {
		this.certificate = certificate;
	}
	
	

}
