package com.mars.rti.dao;

import java.util.ArrayList;
import java.util.Hashtable;
import java.util.List;

import org.hibernate.type.NullableType;

import com.mars.common.model.User;
import com.mars.rti.controller.RTIApplicationDTO;
import com.mars.rti.model.RTIApplication;
import com.mars.rti.model.RTIApplicationDetails;
import com.mars.rti.model.RTIApplicationNoting;
import com.mars.rti.model.RTIApplicationPark;
import com.mars.rti.model.RTIApplicationReAssignAcceptance;
import com.mars.rti.search.RTIApplicationSearch;
import com.mars.workflow.model.WorkflowTemplateUserMappingDetails;

/**
 * <p>
 * Title: RTIApplicationDAO.java
 * </p>
 * <p>
 * Description: This interface is used for hibernate operations for RTIApplication
 * </p>
 * 
 * @see net.zooin.lms.model.RTIApplication Copyright (c) 2014 Mars Telecom India Pvt Ltd
 * @version: 1.0
 * @author : LMS development team <Mars Telecom Systems Pvt Ltd>
 */

public interface RTIApplicationDAO {
	/**
	 * This method returns RTIApplication object for a given Id
	 * 
	 * @param id
	 *        as long
	 * @return RTIApplication as model object
	 */
	public RTIApplication get(long id);

	/**
	 * This method save/updates the RTIApplication information to the database.
	 * 
	 * @param RTIApplication
	 *        object
	 */
	public void save(RTIApplication entity);
	
	public void save(RTIApplication entity,String deleteRTIApplicationServiceDetailsIds,String deleteRTIApplicationAddonDetailsIds);

	/**
	 * This method to merge the RTIApplication information to the database.
	 * 
	 * @param RTIApplication
	 *        object
	 */
	public RTIApplication merge(RTIApplication entity);

	/**
	 * This method delete RTIApplication for a given Id
	 * 
	 * @param id
	 *        as long
	 */
	public void delete(long id);

	/**
	 * This method will return a list of all RTIApplication from the database
	 * 
	 * @return List of RTIApplication
	 */
	public List<RTIApplication> getAll();

	/**
	 * This method save/updates a list of RTIApplication information to the database.
	 * 
	 * @param listRTIApplication
	 *        as List
	 */
	public void saveAll(List<RTIApplication> listRTIApplication);

	/**
	 * This method is used to delete a list of RTIApplication records from the database.
	 * 
	 * @param listRTIApplication
	 *        as List
	 */
	public void deleteAll(List<RTIApplication> listRTIApplication);

	/**
	 * This method returns list of the RTIApplication objects available based page number.
	 * 
	 * @param RTIApplicationSearch
	 *        searchOptions
	 * @return List
	 * @exception Exception
	 */
	public List<RTIApplication> getRTIApplicationList(RTIApplicationSearch searchOptions);
	public List<RTIApplication> getRTIApplicationListProfile(RTIApplicationSearch searchOptions);

	/**
	 * This method returns count of the RTIApplication objects from the database RTIApplicationSearch searchOptions
	 * 
	 * @return long
	 * @exception Exception
	 */
	public long getRTIApplicationCount(RTIApplicationSearch searchOptions);

	/**
	 * This method returns list of RTIApplication objects available based on the value for a particular property.
	 * 
	 * @param String
	 *        propertyName
	 * @param Object
	 *        value
	 * @return List
	 * @exception Exception
	 */
	public List<RTIApplication> findByProperty(String propertyName, Object value);

	/**
	 * This method returns RTIApplication object for a given data
	 * 
	 * @param RTIApplication
	 *        as rtiApplication
	 * @return RTIApplication as model object
	 */
	
	public RTIApplication findByRTIApplicationNumber(String applicationNumber);
	public RTIApplication findByRTIApplicationNumberId(long refid) ;

	public RTIApplication checkForDuplicates(RTIApplication rtiApplication);

	/**
	 * This method returns list of RTIApplication objects available based on the query names passed.
	 * 
	 * @param String
	 *        namedQuery
	 * @param hstKeyValues
	 *        as Hashatble containing the Parameter name as key and value.
	 * @return List
	 * @exception Exception
	 */
	public List<RTIApplication> getListByNamedQuery(String namedQuery, Hashtable<String, Object> hstKeyValues);

	/**
	 * This method returns list of RTIApplication objects available based on the query names passed.
	 * 
	 * @param String
	 *        hqlQuery
	 * @return List
	 * @exception Exception
	 */
	public List<RTIApplication> getListByHqlQuery(String hqlQuery);

	/**
	 * This method returns list of RTIApplication objects available based on the SQL query and parameters.
	 * 
	 * @param String
	 *        SQL Query
	 * @param hstDataTypes
	 *        as Hashatble containing the Scalar Variable and Value
	 * @return List
	 * @exception Exception
	 */
	public List<ArrayList> getListBySQLQuery(String strSql, Hashtable<String, NullableType> hstDataTypes);
	
	public List<RTIApplication> getEntityListBySQLQuery(String strSql, Hashtable<String, NullableType> hstDataTypes);
	
	public List<RTIApplicationDetails> getApplicationHistoryDetails(String propertyName,Object value); 

	public RTIApplicationDetails getRTIApplicationDetailsById(long rtiApplicationDetailsId);
	
	public RTIApplicationDetails getRTIApplicationDetailsByRTIApplicationIdandStatus(long  rtiApplicationId, int status);
	
	public RTIApplicationDetails getRTIApplicationDetailsByRTIApplicationIdandWFLevel(long rtiApplicationId, int wfLevel);	
	
	public RTIApplicationNoting getRTIApplicationNoting(long rtiApplicationNotingId);
	
	public RTIApplicationPark getRTIApplicationParkByRTIApplicationIdandStatus(long rtiApplicationId, int status);
	
	public List<RTIApplicationReAssignAcceptance> getRTIApplicationReAssignedTask(long assignedUser, int acceptStatus);
	
	public RTIApplicationReAssignAcceptance getRTIApplicationReAssignedTaskByRTIApplicationIdAndStatus(long rtiApplicationId, int acceptStatus);
	
	public List<RTIApplicationReAssignAcceptance> getRTIApplicationReAssignedTaskHistory(User assignedUser);

	public RTIApplicationDetails getDetails(long rtiApplicationId);

	public List<RTIApplication> getMyApplicationDetails(String userMobileNo);

	public long getRTIApplicationCountByCount(
			RTIApplicationSearch applicationSearch);

	public void savePaymentList(List<RTIApplication> listrts);
	
	//List Methods
	public List<RTIApplication> getPendingTaskList(String username,long userDept,String zoneNo,long pageNumber,List<WorkflowTemplateUserMappingDetails> workflowTemplateUserMapping,String year);
	public long getPendingTaskListCount(String username,long userDept,String zoneNo,long pageNumber,List<WorkflowTemplateUserMappingDetails> workflowTemplateUserMapping,String year);
	public List<RTIApplication> getRTSApplicationList(String username,long userDept,String zoneNo,long pageNumber,long serviceId,List<WorkflowTemplateUserMappingDetails> workflowTemplateUserMapping,String year);
	public long getRTSApplicationListCount(String username,long userDept,String zoneNo,long pageNumber,long serviceId,List<WorkflowTemplateUserMappingDetails> workflowTemplateUserMapping,String year);

	public RTIApplication findByServiceIdApplicationSearch(String rtsappNo);

	public List<RTIApplication> getListByServiceId(int serviceId);
	
	public List<RTIApplicationDTO> getList(long id);

	RTIApplication findZOneTransferApplicationNumber(String rtiApplnNumber);


	
	public RTIApplication getApplicationDataForBirthCertificate(String applicationNumber) ;


public long getRTSApllicationListByServiceIDAndYear(int serviceId, String year);

}
