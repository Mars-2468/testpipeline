package com.mars.common.search;

public class ZoneMasterSearch extends BaseSearchObject {
	
	private String searchZoneName;

	private String searchStatus;

	public ZoneMasterSearch(){
	}
	
	public String getSearchZoneName() {
		return searchZoneName;
	}

	public void setSearchZoneName(String searchZoneName) {
		this.searchZoneName = searchZoneName;
		if (this.searchZoneName != null && this.searchZoneName.length() > 0)
		      setSearchParamSet(true);
	}

	public String getSearchStatus() {
		return searchStatus;
	}


	public void setSearchStatus(String searchStatus) {
		this.searchStatus = searchStatus;
		if (this.searchStatus != null && this.searchStatus.length() > 0)
		      setSearchParamSet(true);
	}

}
