package com.mars.rti.service.impl;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.mars.rti.dao.TreeCuttingReasonDAO;
import com.mars.rti.model.TreeCuttingReason;
import com.mars.rti.service.TreeCuttingReasonService;

@Service
public class TreeCuttingReasonServiceImpl implements  TreeCuttingReasonService{

	 @Autowired
	 private TreeCuttingReasonDAO treeCuttingReasonDAO;

	@Override
	public List<TreeCuttingReason> getTreeCutingReason() {
		// TODO Auto-generated method stub
		return treeCuttingReasonDAO.getTreeCutingReason();
	}
	 
	 
}
