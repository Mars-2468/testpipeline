package com.mars.rti.model;

import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.Id;
import javax.persistence.Table;

@Entity
@Table(name="zone_esr",schema="egovcommon")
public class ZoneEsr {

	@Id
	@Column(name="zoneid")
	private long zoneId;
	
	@Column(name="esrid")
	private String esrId;
	
	@Column(name="esrname")
	private String esrName;

	public long getZoneId() {
		return zoneId;
	}

	public void setZoneId(long zoneId) {
		this.zoneId = zoneId;
	}

	public String getEsrId() {
		return esrId;
	}

	public void setEsrId(String esrId) {
		this.esrId = esrId;
	}

	public String getEsrName() {
		return esrName;
	}

	public void setEsrName(String esrName) {
		this.esrName = esrName;
	}
	
	
}
