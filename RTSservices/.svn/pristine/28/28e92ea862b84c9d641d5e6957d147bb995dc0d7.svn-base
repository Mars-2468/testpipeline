package com.mars.rti.search;
import com.mars.common.search.BaseSearchObject;

public class RTIApplicationSearch extends BaseSearchObject {
	

	
	private String rtiApplicationNumber;
	private String creationFromDate;
	private String creationToDate;
	private String subject; 
	private long tenancyId;	
	private int zone;
	private String finalStatus;
	private String receivedFileRefNo; 
	private String templatename;
	private long assignedDepartment;
	private long assignedSection;	
	private long assignedUser; 
	private String year;
	
	private long  rtiAplicationReceivedDepartment;
	
	private Integer isRTIAppealApplication;
	
	private String reportType;
	
	private long birthRegistrationId;
	
	private String name;
	
	private Integer rtiserviceid;
	
	private String mobileNumber;
	
	private String phoneNumber;
	
	private String user;


	public Integer getRtiserviceid() {
		return rtiserviceid;
	}

	public void setRtiserviceid(Integer rtiserviceid) {
		this.rtiserviceid = rtiserviceid;
	}

	      	
	public String getRtiApplicationNumber() {
		return rtiApplicationNumber;
	}
	public void setRtiApplicationNumber(String rtiApplicationNumber) {
		this.rtiApplicationNumber = rtiApplicationNumber; 
	}
	
	public String getCreationFromDate() {
		return creationFromDate;
	}
	public void setCreationFromDate(String creationFromDate) {
		this.creationFromDate = creationFromDate;
		if(this.creationFromDate != null  && this.creationFromDate.length() > 0)setSearchParamSet(true);
		
	}
	public String getCreationToDate() {
		return creationToDate;
	}
	public void setCreationToDate(String creationToDate) {
		this.creationToDate = creationToDate;
		if(this.creationToDate != null  && this.creationToDate.length() > 0)setSearchParamSet(true);
	}
	public String getSubject() {
		return subject;
	}
	public void setSubject(String subject) {
		this.subject = subject;
		if(this.subject != null  && this.subject.length() > 0)setSearchParamSet(true);
	}
	
	public long getBirthRegistrationId() {
		return birthRegistrationId;
	}
	public void setBirthRegistrationId(long birthRegistrationId) {
		this.birthRegistrationId = birthRegistrationId;
	}
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public long getTenancyId() {
		return tenancyId;
	}

	public void setTenancyId(long tenancyId) {
		this.tenancyId = tenancyId;
		if(this.tenancyId>0){
			setSearchParamSet(true);
		}
	}
	
	public String getFinalStatus() {
		return finalStatus;
	}
	public void setFinalStatus(String finalStatus) {
		this.finalStatus = finalStatus;
		if(this.finalStatus != null  && this.finalStatus.length() > 0)setSearchParamSet(true);
	}
	
	public String getReceivedFileRefNo() {
		return receivedFileRefNo;
	}
	public void setReceivedFileRefNo(String receivedFileRefNo) {
		this.receivedFileRefNo = receivedFileRefNo;
	} 
	public long getAssignedDepartment() {
		return assignedDepartment;
	}
	public void setAssignedDepartment(long assignedDepartment) {
		this.assignedDepartment = assignedDepartment;
	}


	public long getAssignedSection() {
		return assignedSection;
	}
	public void setAssignedSection(long assignedSection) {
		this.assignedSection = assignedSection;
	}
	public long getAssignedUser() {
		return assignedUser;
	}
	public void setAssignedUser(long assignedUser) {
		this.assignedUser = assignedUser;
	}
	public long getRtiAplicationReceivedDepartment() {
		return rtiAplicationReceivedDepartment;
	}
	public void setRtiAplicationReceivedDepartment(
			long rtiAplicationReceivedDepartment) {
		this.rtiAplicationReceivedDepartment = rtiAplicationReceivedDepartment;
	}
	public Integer getIsRTIAppealApplication() {
		return isRTIAppealApplication;
	}
	public void setIsRTIAppealApplication(Integer isRTIAppealApplication) {
		this.isRTIAppealApplication = isRTIAppealApplication;
	}
	public String getReportType() {
		return reportType;
	}
	public void setReportType(String reportType) {
		this.reportType = reportType;
	}

	public String getMobileNumber() {
		return mobileNumber;
	}

	public void setMobileNumber(String mobileNumber) {
		this.mobileNumber = mobileNumber;
	}

	public String getPhoneNumber() {
		return phoneNumber;
	}

	public void setPhoneNumber(String phoneNumber) {
		this.phoneNumber = phoneNumber;
	}

	public int getZone() {
		return zone;
	}

	public void setZone(int zone) {
		this.zone = zone;
	}

	public String getUser() {
		return user;
	}

	public void setUser(String user) {
		this.user = user;
	}

	public String getTemplatename() {
		return templatename;
	}

	public void setTemplatename(String templatename) {
		this.templatename = templatename;
	}

	public String getYear() {
		return year;
	}

	public void setYear(String year) {
		this.year = year;
	}

	
	
	
}
