package com.mars.rti.model;

import java.util.List;

import com.fasterxml.jackson.annotation.JsonProperty;

public class GetRTSPropertyCollectionDetail {
    
    @JsonProperty("GetRTSPropertyCollectionDetailResult")
    private GetRTSPropertyCollectionDetailResult getRTSPropertyCollectionDetailResult;

    public GetRTSPropertyCollectionDetailResult getGetRTSPropertyCollectionDetailResult() {
        return getRTSPropertyCollectionDetailResult;
    }

    public void setGetRTSPropertyCollectionDetailResult(
