<project name="BND" default="autobuild" basedir=".">


	<!-- Source for java files -->
	<property name="dev.home.dir" value="." />
	<property name="dev.source.java.dir" value="${dev.home.dir}\java" />
	<property name="dev.resources.java.dir" value="${dev.home.dir}\resources" />
	<property name="dev.resources.hibernate.dir" value="${dev.home.dir}\resources\hibernate" />
	<property name="dev.resources.templates.dir" value="${dev.home.dir}\resources\templates" />
	<property name="dev.resources.jbpm.dir" value="${dev.home.dir}\resources\workflow" />
	<!-- Source configuration files -->

	<!-- Web related files -->
	<property name="dev.web.home.dir" value="${dev.home.dir}\web" />

	<!-- WEB - INF folder -->
	<property name="dev.web.web-inf.dir" value="${dev.web.home.dir}\WEB-INF" />

	<!-- Classes folder -->
	<property name="dev.web.classes.dir" value="${dev.web.web-inf.dir}\classes" />

	<target name="autobuild">
		<copy todir="${dev.web.web-inf.dir}">
			<fileset dir="${dev.resources.java.dir}">
				<include name="*.xml" />
				<exclude name="log4j.xml" />
				<exclude name="autogenerated/*" />
				<exclude name="*.properties" />
				<exclude name="jbpm.cfg.xml" />
				<exclude name="jbpm.hibernate.cfg.xml" />
				<exclude name="jbpm.mail.templates.xml"/>
			</fileset>
		</copy>
		<copy todir="${dev.web.classes.dir}">
			<!--<fileset dir="${dev.resources.hibernate.dir}">
				<include name="*.xml" />
			</fileset>-->
			<fileset dir="${dev.resources.templates.dir}">
				<include name="*.vm" />
			</fileset>
			<fileset dir="${dev.resources.java.dir}">
				<include name="log4j.xml" />
				<include name="*.properties" />
				<include name="jbpm.cfg.xml" />
				<include name="jbpm.hibernate.cfg.xml" />
				<include name="jbpm.mail.templates.xml"/>
			</fileset>
		</copy>

		<!-- copy xml files to web inf -->
		<copy todir="${dev.web.web-inf.dir}">
			<fileset dir="${dev.resources.java.dir}\common">
				<include name="*.xml" />
			</fileset>
			<fileset dir="${dev.resources.java.dir}\core">
				<include name="*.xml" />
			</fileset>
			<fileset dir="${dev.resources.java.dir}\workflow">
				<exclude name="*.jpdl.xml" />
				<exclude name="*.properties" />
			</fileset>			
		</copy>

		<!-- copy properties files to classes-->
		<copy todir="${dev.web.classes.dir}">
			<fileset dir="${dev.resources.java.dir}\common">
				<include name="*.properties" />
			</fileset>
			<fileset dir="${dev.resources.java.dir}\core">
				<include name="*.properties" />
			</fileset>
			<fileset dir="${dev.resources.java.dir}\workflow">
				<include name="*.properties" />
			</fileset>			
		</copy>

		<!-- Copy hbm files -->

		<!--<copy todir="${dev.web.classes.dir}\hibernate\common">
			<fileset dir="${dev.resources.hibernate.dir}\common">
				<include name="*.hbm.xml" />
			</fileset>
		</copy> -->
		<copy todir="${dev.web.classes.dir}\hibernate\dms">
			<fileset dir="${dev.resources.hibernate.dir}\dms">
				<include name="*.hbm.xml" />
			</fileset>
		</copy>
		<!-- <copy todir="${dev.web.classes.dir}\hibernate\workflow">
			<fileset dir="${dev.resources.hibernate.dir}\workflow">
				<include name="*.hbm.xml" />
			</fileset>
		</copy>-->
		<!--<copy todir="${dev.web.classes.dir}\hibernate\core">
			<fileset dir="${dev.resources.hibernate.dir}\core">
				<include name="*.hbm.xml" />
			</fileset>
		</copy> -->
		
		<copy todir="${dev.web.classes.dir}\workflow">
			<fileset dir="${dev.resources.jbpm.dir}">
				<include name="*.jpdl.xml" />
			</fileset>
		</copy>
	</target>

</project>